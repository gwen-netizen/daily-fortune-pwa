{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/(styles\\.css|app\\.js|manifest\\.json|sw\\.js|assets/.*)",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/landing.html"
    }
  ]
}
