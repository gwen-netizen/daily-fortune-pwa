{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/landing.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/(styles\\.css|app\\.js|manifest\\.json|sw\\.js|assets/.*)",
      "destination": "/$1"
    }
  ]
}
